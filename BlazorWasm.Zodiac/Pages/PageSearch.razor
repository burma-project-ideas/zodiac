@using BlazorWasm.Zodiac.Data
@using BlazorWasm.Zodiac.Models
<section class="hero">
    <a class="announcement" href="#signs"><span><i></i> Written in the stars</span> A little self discovery <b aria-hidden="true">→</b></a>
    <h1>Your birthday. A whole<br class="desktop-break" /> new way to see yourself.</h1>
    <p>Get to know your zodiac sign, explore what makes you unique,<br class="desktop-break" /> and discover your story — in English and Myanmar.</p>
    <div class="hero-actions"><a class="button" href="#signs"><span aria-hidden="true">◎</span> Explore the signs</a><a class="button primary" href="#reading">Find my sign <span aria-hidden="true">→</span></a></div>
</section>
<section class="workspace-wrap" id="reading" aria-label="Zodiac reading">
 <div class="workspace">
    <aside class="workspace-sidebar" aria-label="Reading overview"><span class="mini-brand"><span class="brand-mark" aria-hidden="true">✦</span> Your universe</span><a class="sidebar-active" href="#reading"><span aria-hidden="true">◈</span> Overview</a><a href="#signs"><span aria-hidden="true">◎</span> All zodiac signs</a><a href="#about"><span aria-hidden="true">◇</span> How it works</a><div class="sidebar-note"><span class="small-star" aria-hidden="true">✦</span><strong>A little insight goes a long way.</strong><p>Start with your birthday.<br />Discover something new.</p></div><div class="sidebar-credit"><span class="avatar">B</span><div><strong>Burma Project Ideas</strong><small>Made for everyone</small></div></div></aside>
    <div class="workspace-main">
        <div class="workspace-heading"><div><span class="eyebrow">YOUR PERSONAL COSMIC GUIDE</span><h2>Your zodiac, at a glance</h2><p>A fresh perspective, written in the stars.</p></div><span class="live-badge"><i></i> Free to explore</span></div>
        <form class="birthday-form" @onsubmit="SearchDate" @onsubmit:preventDefault><div><label for="birthday">Your birthday</label><input id="birthday" type="date" @bind="_birthDate" required aria-describedby="birthday-hint" /><span id="birthday-hint">Just your birthday. No account needed.</span></div><button class="button primary" type="submit">Find my sign <span aria-hidden="true">→</span></button></form>
        @if (!string.IsNullOrEmpty(_error)) { <p class="error" role="alert">@_error</p> }
        <div class="reading-status" role="status">@(_isSearch ? "Your reading is ready. Meet " + _zodiacSign.Name + "." : "A little preview · Choose your birthday for your own reading")</div>
        <div class="reading-grid">
            <article class="sign-summary"><span class="eyebrow">@(_isSearch ? "YOUR ZODIAC SIGN" : "AN EXAMPLE READING")</span><div class="sign-title"><div><h3>@_zodiacSign.Name</h3><p>@_zodiacSign.Dates</p></div><span class="sign-symbol"><img src="@_zodiacSign.ZodiacSignImageUrl" alt="" /></span></div><div class="sign-tags"><span>@_zodiacSign.Element sign</span><span lang="my">@_zodiacSign.MyanmarMonth</span></div><div class="sign-art"><img src="@_zodiacSign.ZodiacSign2ImageUrl" alt="@(_zodiacSign.Name + " zodiac artwork")" /></div><span class="art-caption">A sign with a story of its own.</span></article>
            <article class="traits-panel"><div class="panel-heading"><h3>Personality traits</h3><span class="subtle-icon" aria-hidden="true">◉</span></div><p>The qualities that make this sign unique.</p><div id="chart" role="img" aria-label="@(_zodiacSign.Name + " personality radar chart")"></div><div class="trait-legend">@foreach (var trait in _zodiacSign.Traits) { <span><i></i>@trait.Name <b>@trait.Percentage%</b></span> }</div></article>
        </div>
        @if (_isSearch) { <div class="reading-actions"><button class="text-button" @onclick="Back">← Start a new reading</button><a href="#story">Explore your full story ↓</a></div> }
    </div>
 </div>
</section>
<section class="community-strip"><p>A community project. A universe of possibilities.</p><div><strong>Burma Project Ideas</strong><span>12 zodiac signs</span><span>Myanmar stories</span><span>One unique you</span></div></section>
@if (_isSearch)
{
<section class="section stories" id="story"><div class="section-heading"><span class="eyebrow">MORE THAN A SIGN</span><h2>The story of @_zodiacSign.Name</h2><p>Your character, connections, and the little things that make you, you.</p></div><div class="story-grid">@foreach (var entry in new[] { ("Life purpose", _zodiacSign.LifePurpose), ("Loyalty & connections", _zodiacSign.Loyal), ("When emotions run high", _zodiacSign.Angry), ("Your character", _zodiacSign.Character), ("Your unique features", _zodiacSign.PrettyFeatures), ("Representative flower", _zodiacSign.RepresentativeFlower) }) { <article class="story"><h3>@entry.Item1</h3><p lang="my">@entry.Item2</p></article> }</div></section>
}
<section class="section" id="signs"><div class="section-heading"><span class="eyebrow">TWELVE SIGNS. ENDLESS PERSONALITIES.</span><h2>Find a little of yourself in the stars.</h2><p>Get curious. Explore every sign and see what makes each one special.</p></div><div class="signs-grid">@foreach (var sign in JsonData.ZodiacSigns) { <button class="sign-card" @onclick="() => Sign(sign.Name)"><span class="catalog-symbol"><img src="@sign.ZodiacSignImageUrl" alt="" loading="lazy" /></span><strong>@sign.Name <span aria-hidden="true">↗</span></strong><span>@sign.Dates</span><small>@sign.Element</small></button> }</div></section>
<section class="about-section" id="about"><div class="section-heading"><span class="eyebrow">SIMPLE BY DESIGN</span><h2>A little insight. No extra steps.</h2><p>Everything you need to explore your sign, all in one place.</p></div><div class="features"><article><span class="feature-icon" aria-hidden="true">◎</span><h3>Start with a birthday</h3><p>Choose a date and discover the Western zodiac sign that goes with it.</p></article><article><span class="feature-icon" aria-hidden="true">◈</span><h3>See the bigger picture</h3><p>Explore personality traits, elements, flowers, and stories in Myanmar.</p></article><article><span class="feature-icon" aria-hidden="true">◇</span><h3>Keep your birthday yours</h3><p>Your reading happens in your browser. No sign-up, no database, no fuss.</p></article></div></section>
<section class="section faq-section" id="faq"><div class="section-heading"><h2>Frequently asked questions</h2><p>A few things you might be wondering.</p></div><div class="faq-list"><details open><summary>How is my zodiac sign calculated?</summary><p>We use the month and day of your birthday to find your Western sun sign. Each sign has a fixed date range, which you can see above.</p></details><details><summary>Where do the Myanmar stories come from?</summary><p>The descriptions, personality traits, and original artwork dataset come from Burma Project Ideas. You can find the full credits in our GitHub repository.</p></details><details><summary>Do I need an account?</summary><p>No. The app runs in your browser and does not send your birthday to a server or store it in a database.</p></details><details><summary>Are these readings scientific predictions?</summary><p>No. Explore them for entertainment, cultural interest, and self reflection.</p></details></div><div class="bottom-cta"><span class="brand-mark" aria-hidden="true">✦</span><h3>Your story starts with a date.</h3><p>Get curious about what makes you unique.</p><a class="button primary" href="#reading">Find my sign <span aria-hidden="true">→</span></a></div></section>
